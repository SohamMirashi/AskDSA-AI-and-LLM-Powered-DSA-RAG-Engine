{
  "manifest_version": 3,
  "name": "AskDSA Tutor",
  "version": "0.1.0",
  "description": "Grounded DSA interview tutor — progressive hints on coding problems, without spoiling the answer.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://askdsa.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open AskDSA" },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://*.geeksforgeeks.org/*",
        "*://*.codechef.com/*",
        "*://*.hackerrank.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}